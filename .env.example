# Helcim API key
HELCIM_API_KEY=

# Set to true to use Helcim sandbox (no real transactions)
HELCIM_TEST_MODE=true

# HMAC secret for verifying Helcim webhook payloads
HELCIM_WEBHOOK_SECRET=

# Twilio account SID
TWILIO_ACCOUNT_SID=

# Twilio auth token
TWILIO_AUTH_TOKEN=

# E.164 Twilio sender number (e.g. +15550001234)
TWILIO_FROM_NUMBER=
