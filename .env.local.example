# ── Firebase client SDK (Project Settings → General → Your apps → SDK setup) ──

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (Project Settings → Service accounts → Generate new private key) ──
# Paste the entire downloaded JSON as a single-line string (minified / no newlines)

FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Vercel Blob (company logo + menu item image uploads, company hard-delete sweep) ──
# On Vercel (Production/Preview), auth is automatic via BLOB_STORE_ID + VERCEL_OIDC_TOKEN
# once the store is connected to the project — no token needed there.
# For local dev, either connect the store to the Development environment too and run
# `vercel env pull`, or set a static token here from the store's dashboard settings.

BLOB_READ_WRITE_TOKEN=
