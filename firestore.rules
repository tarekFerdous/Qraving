rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperadmin() {
      return request.auth != null && request.auth.token.role == 'superadmin';
    }

    function isManagerFor(companyId) {
      return request.auth != null
        && request.auth.token.role == 'manager'
        && request.auth.token.companyId == companyId;
    }

    // Users collection — only superadmin or the user themselves can read; only server can write
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperadmin());
      allow write: if false; // written only via Admin SDK (API routes)
    }

    // Orders — written only via Admin SDK; readable by superadmin or managers
    match /orders/{orderId} {
      allow read: if isSuperadmin() || (request.auth != null && request.auth.token.role == 'manager');
      allow write: if false; // written only via Admin SDK
    }

    // Companies — superadmin writes; anyone reads
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isSuperadmin();

      match /nodes/{nodeId} {
        allow read: if true;
        allow write: if isSuperadmin();
      }

      match /branches/{branchId} {
        allow read: if true;
        allow write: if isSuperadmin() || isManagerFor(companyId);

        match /categories/{categoryId} {
          allow read: if true;
          allow write: if isSuperadmin() || isManagerFor(companyId);

          match /items/{itemId} {
            allow read: if true;
            allow write: if isSuperadmin() || isManagerFor(companyId);
          }
        }

        match /menuItems/{itemId} {
          allow read: if true;
          allow write: if isSuperadmin() || isManagerFor(companyId);
        }

        match /menu/{docId} {
          allow read: if true;
          allow write: if isSuperadmin() || isManagerFor(companyId);
        }

        match /sessions/{sessionId} {
          allow read, write: if true;
          match /baskets/{userId} {
            allow read, write: if true;
          }
        }

        match /orders/{orderId} {
          allow read: if isSuperadmin() || isManagerFor(companyId);
          allow update: if isSuperadmin() || isManagerFor(companyId);
          allow create, delete: if false; // written only via Admin SDK (order submission)
        }
      }
    }
  }
}
