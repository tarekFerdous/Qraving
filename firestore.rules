rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /companies/{companyId}/branches/{branchId}/categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /companies/{companyId}/branches/{branchId}/menuItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /companies/{companyId}/branches/{branchId}/sessions/{sessionId} {
      allow read, write: if true;
      match /baskets/{userId} {
        allow read, write: if true;
      }
    }
  }
}
